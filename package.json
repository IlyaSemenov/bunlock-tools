{
  "name": "bunlock-tools-workspace",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@arethetypeswrong/core": "^0.18.5",
      "@tsconfig/bun": "^1.0.11",
      "@types/bun": "^1.4.4",
      "@types/semver": "^7.8.0",
      "publint": "^0.3.25",
      "tsdown": "^0.23.2"
    }
  },
  "type": "module",
  "scripts": {
    "build": "bun run --workspaces --if-present build",
    "types": "bun run --workspaces --if-present types",
    "test": "bun run --workspaces --if-present test",
    "lint": "oxlint --fix && oxfmt",
    "lint:check": "oxlint && oxfmt --check",
    "check": "bun run types && bun run lint",
    "changeset": "changeset",
    "prepare": "lefthook install",
    "version-packages": "changeset version && bun install --lockfile-only"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@ilyasemenov/oxc-config": "^0.1.1",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0"
  },
  "packageManager": "bun@1.4.4"
}
